{
  "info": {
    "name": "Sparkleen Mobile API v1",
    "description": "REST API aplikasi mobile pelanggan Sparkleen Laundry.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "id_transaksi",
      "value": "1",
      "type": "string"
    },
    {
      "key": "id_permintaan",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Budi Santoso\",\n  \"no_telp\": \"081298765432\",\n  \"alamat\": \"Jl. Merdeka No. 10\",\n  \"pin\": \"654321\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) { pm.collectionVariables.set('token', json.data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Activate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"no_telp\": \"081298765432\",\n  \"no_nota\": \"LAU/20261021/0001\",\n  \"pin\": \"654321\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/activate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "activate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) { pm.collectionVariables.set('token', json.data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"no_telp\": \"081298765432\",\n  \"pin\": \"654321\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) { pm.collectionVariables.set('token', json.data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Profil",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me"]
            }
          }
        },
        {
          "name": "Update Me",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Budi Santoso\",\n  \"alamat\": \"Jl. Merdeka No. 11\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Katalog",
      "item": [
        {
          "name": "Layanan",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/layanan",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "layanan"]
            }
          }
        },
        {
          "name": "Outlet",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/outlet",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "outlet"]
            }
          }
        }
      ]
    },
    {
      "name": "Transaksi",
      "item": [
        {
          "name": "List Transaksi",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/transaksi?status=semua&page=1&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transaksi"],
              "query": [
                { "key": "status", "value": "semua" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Detail Transaksi",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/transaksi/{{id_transaksi}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transaksi", "{{id_transaksi}}"]
            }
          }
        },
        {
          "name": "Nota",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/transaksi/{{id_transaksi}}/nota",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transaksi", "{{id_transaksi}}", "nota"]
            }
          }
        }
      ]
    },
    {
      "name": "Permintaan",
      "item": [
        {
          "name": "Buat Permintaan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_layanan\": 1,\n  \"berat_perkiraan\": 4.5,\n  \"alamat_jemput\": \"Jl. Melati No. 7, RT 2\",\n  \"tgl_jemput\": \"{{pickup_date}}\",\n  \"slot_jemput\": \"siang\",\n  \"catatan\": \"Cuci pisah dengan handuk\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/permintaan",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "permintaan"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.variables.set('pickup_date', new Date(Date.now() + 31 * 60 * 60 * 1000).toISOString().slice(0, 10));"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id_permintaan) { pm.collectionVariables.set('id_permintaan', json.data.id_permintaan); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Daftar Permintaan",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/permintaan?status=aktif&page=1&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "permintaan"],
              "query": [
                { "key": "status", "value": "aktif" },
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Detail Permintaan",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/permintaan/{{id_permintaan}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "permintaan", "{{id_permintaan}}"]
            }
          }
        },
        {
          "name": "Batal Permintaan",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/permintaan/{{id_permintaan}}/batal",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "permintaan", "{{id_permintaan}}", "batal"]
            }
          }
        }
      ]
    },
    {
      "name": "Pembayaran",
      "item": [
        {
          "name": "[PLANNED] Buat Intent Pembayaran",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metode\": \"QRIS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/transaksi/{{id_transaksi}}/pembayaran",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transaksi", "{{id_transaksi}}", "pembayaran"]
            }
          }
        },
        {
          "name": "[PLANNED] Buat Intent Transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metode\": \"TRANSFER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/transaksi/{{id_transaksi}}/pembayaran",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transaksi", "{{id_transaksi}}", "pembayaran"]
            }
          }
        },
        {
          "name": "[PLANNED] Status Pembayaran",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/transaksi/{{id_transaksi}}/pembayaran",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transaksi", "{{id_transaksi}}", "pembayaran"]
            }
          }
        },
        {
          "name": "[PLANNED] Batal Intent Pembayaran",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/transaksi/{{id_transaksi}}/pembayaran/batal",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transaksi", "{{id_transaksi}}", "pembayaran", "batal"]
            }
          }
        }
      ]
    }
  ]
}
